target/
Cargo.lock
__pycache__/
node_modules/

# ─────────────────────────────────────────────
# Never-commit secret guardrails (code-plan C9)
# ─────────────────────────────────────────────
# Real env files and secret material must never be committed. Commit only
# the *.env.example / *.sample / *.dist placeholder templates (see
# scripts/secret-scan.py; pre-commit hook + CI job enforce this).
.env
.env.*
!.env.example
!.env.sample
!.env.dist
*.env
!*.env.example
!*.env.sample
!*.env.dist
config.yml
config.local.yml
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.jks
*.keystore
*.secret
*.credential
secrets.env
secrets.env.*
id_rsa
id_ecdsa
id_ed25519
