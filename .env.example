# omni-plugins - local environment template (code-plan C9 never-commit guardrail)
#
# Copy this file to `.env` (gitignored) and fill in REAL values before
# running plugin tests locally. NEVER commit `.env` or any file holding
# live secrets - the pre-commit hook and CI job (scripts/secret-scan.py)
# block them.
#
# All values below are placeholders (xxxx). Replace every xxxx before use.
RUST_LOG=info
LLM_API_KEY=xxxx-your-provider-api-key
